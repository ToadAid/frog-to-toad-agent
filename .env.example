# ── Telegram ────────────────────────────────────────────────────────────────
# Optional repository-root override. FROG_TO_TOAD_DIR is preferred;
# TRADING_DESK_DIR remains accepted for compatibility with donor installs.
#FROG_TO_TOAD_DIR=/absolute/path/to/frog-to-toad-agent

# Easiest path: `npm run onboard` fills this whole file in with you (§12.7).
# Manual path: get a token from @BotFather, then run: npm run dev and message
# your bot once and capture both the private chat id and your sender user id.
TELEGRAM_BOT_TOKEN=
# Your own numeric Telegram chat id (the only chat allowed to approve trades)
TELEGRAM_ADMIN_CHAT_ID=
# Your own positive Telegram user id (the only person allowed to act as principal)
TELEGRAM_PRINCIPAL_USER_ID=
# Optional: other chat ids allowed to TALK to the desk (they still cannot approve)
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional: progress drafts — one live bubble edited in place while the agent
# works, becoming the final answer (the "alive" feel). Default on.
#TELEGRAM_PROGRESS_DRAFTS=off
#
# GROUP CHATS: add the bot to a group and it ONLY answers when @mentioned
# (replies and chatter are ignored). Both the bot's real username and its
# display name work as the trigger. A group's chat id is NEGATIVE
# (e.g. -1001234567890) — message the group once, the agent's rejection reply
# prints the id, then add it here:
#   TELEGRAM_ALLOWED_CHAT_IDS=123456789,-1001234567890
# Group members can research/chat; trade approvals still ONLY work from
# TELEGRAM_PRINCIPAL_USER_ID (everyone else's button presses get "🔒 not authorized").

# ── LLM brain ───────────────────────────────────────────────────────────────
# BRAIN picks the credential lane; defaults to glm (the LLM_PROVIDER presets).
#   BRAIN=glm    → the LLM_PROVIDER presets below (API-key or local lanes)
#   BRAIN=codex  → OpenAI Codex models via ChatGPT WEB-LOGIN OAuth (the Codex
#                  CLI flow): run `npm run desk login` once, tokens land in
#                  data/state/codex-auth.json (chmod 600, gitignored — NEVER
#                  this .env, NEVER chat). No LLM_API_KEY involved. Model:
#BRAIN=glm
#CODEX_MODEL=gpt-5.6-sol
#
# GLM lane — pick a provider preset (LLM_MODEL can override any preset's model):
#   LLM_PROVIDER=zai     → https://api.z.ai/api/paas/v4   glm-4.6            (default, home stack 🇨🇳)
#   LLM_PROVIDER=openai  → https://api.openai.com/v1      gpt-4o-mini        (needs LLM_API_KEY)
#   LLM_PROVIDER=codex   → https://api.openai.com/v1      gpt-5.3-codex      (Responses API; API-KEY lane —
#                          for the ChatGPT-login lane use BRAIN=codex instead)
#   LLM_PROVIDER=ollama  → http://127.0.0.1:11434/v1      glm-5.3-flash:cloud (no API key needed)
LLM_PROVIDER=zai
# Optional model override, e.g. LLM_MODEL=glm-5.3-flash:cloud
LLM_MODEL=
# Required for zai / openai / codex (API-key lane); NOT needed for ollama or BRAIN=codex
LLM_API_KEY=
# Custom OpenAI-compatible endpoint instead? Comment out LLM_PROVIDER and set:
#   LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=openai/gpt-4o  LLM_API_KEY=sk-or-…
# Verify auth for whichever brain you picked:  npm run smoke:llm
# Any other OpenAI-compatible provider works too, e.g.:
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=openai/gpt-4o  LLM_API_KEY=sk-or-…
#   local vLLM: LLM_BASE_URL=http://127.0.0.1:8000/v1      LLM_API_KEY=none

# ── Safety switches ─────────────────────────────────────────────────────────
# DRY_RUN=true  → agent quotes and narrates trades, NEVER signs. Keep true.
# Flipping to false is refused unless EXECUTION_MODE=coinbase-mcp (Phase 7).
DRY_RUN=true
# Frog-to-Toad A0: when true, ONLY guarded swap_execute calls may proceed
# without a human approval card, and ONLY while DRY_RUN=true. Raw wallet
# transfers/approvals remain human-gated. Live mode + this flag refuses boot.
AUTONOMOUS_DRY_RUN=false
# Frog-to-Toad A1: finite simulated capital granted by the principal.
# NO DEFAULT by design. AUTONOMOUS_DRY_RUN=true refuses boot until this is a
# positive finite USD amount. The frog may spend/earn resources; it may not
# invent its starting bankroll.
APPRENTICESHIP_SEED_USD=
# Frog-to-Toad A2: principal-owned autonomous wake cadence, 5-field cron in
# USER_TIMEZONE. NO DEFAULT: blank means the frog has no autonomous clock.
# Example only: APPRENTICESHIP_WAKE_CRON=17 */4 * * *
APPRENTICESHIP_WAKE_CRON=
EXECUTION_MODE=none
LOG_LEVEL=info
STATUS_PORT=8787
# The timezone the PRINCIPAL lives in (IANA name) — drives every "today/yesterday" the desk reasons about.
# Defaults to the server zone when unset.
#USER_TIMEZONE=America/New_York
# Turns between [memory nudge] reminders in the agent loop (Hermes pattern:
# prompts agents to save durable facts mid-run). 0 disables. Default 10.
#MEMORY_NUDGE_INTERVAL=10
# After-turn seam v2: how many hook-directed follow-up passes a run may perform
# (each pass re-enters the brain with one `[after-turn hook]` message after a
# clean FINAL pass; ABORTED/ERROR/spent budgets are never extended). 0
# disables continuation (a negative value is invalid and also disables).
# Unset/garbage → default 2. Hard clamp 10.
#AFTER_TURN_FOLLOWUP_MAX=2
# Skills are discovered from skills/<name>/SKILL.md. Their prompt listing is
# bounded independently of playbook body size; lower this if the roster is
# large. Direct /skill invocation works in Telegram and the TUI. Tool lists in
# skill frontmatter are narrowing-only and never grant tools.
#SKILL_LIST_CHAR_BUDGET=8000
# Chat window: last N messages re-sent each turn (full transcript is kept on
# disk regardless). Default 80. Lower saves tokens; compaction is the future lever.
#THREAD_MESSAGES=80
# Workspace memory char caps (model-independent). Defaults 1375 (USER.md) and
# 2200 (DESK.md). Raise only if the frog keeps hitting the cap wall, e.g.:
#MEMORY_DESK_CHARS=3584

# ── Proactive rituals (Phase 10) — the desk talks FIRST, not on request ──
# Morning brief: deterministic daily digest (portfolio + PnL + mood + headlines
# + Kronos record) sent to the admin chat. Principal's timezone. '' = off.
#MORNING_BRIEF_CRON=47 8 * * *
# Sentinel scan: taps your shoulder when it SEES opportunity or risk —
# sentiment extremes (F&G ≤25/≥75 zone crossings), majors moving ≥
# SENTINEL_MOVE_PCT in 24h, stablecoin 7d flow ≥ ±1%. Cooldowns prevent nagging.
#SENTINEL_CRON=19 */2 * * *
#SENTINEL_MOVE_PCT=5
# Watchdog (Phase 11.4): the desk watches ITSELF — brain reachability + ritual
# staleness (no cron fired in 6h → scheduler may be dead). '' = off.
#WATCHDOG_CRON=37 */2 * * *
# Approval throttle (Phase 11.8, Nautilus message-bus steal): max cards pending
# at once + minimum seconds between cards. An un-sent card is a DENIED card.
#APPROVAL_MAX_PENDING=3
#APPROVAL_MIN_INTERVAL_SEC=5

# ── Wallet lane (Phase 7) — THE GATE, flipped on/off here in .env ──
# OFF (default, dry-run): leave DRY_RUN unset or =true. The desk simulates; no
#   wallet server is ever spawned; nothing below is read.
# ON (real mode): ALL of the following together —
#   1. DRY_RUN=false
#   2. EXECUTION_MODE=coinbase-mcp  (Coinbase CDP server-signer; swaps supported)
#      …or EXECUTION_MODE=cobo-mcp  (Cobo Agentic Wallet; transfer/observe/pacts —
#      no swaps: contract_call is deliberately not exposed on the desk lane yet)
#   3. MCP_COMMAND pointing at the external wallet server (the signer lives
#      THERE, never in this process; keys go in that server's own .env, NOT here)
#   4. MCP_ALLOWED_TOOLS naming the exact server tools (deny-by-default)
#   5. GUARDED_TOOLS listing every funds-moving tool — the loop denies a
#      dangerous tool that is NOT on this list, so name them all
#
# Coinbase-compatible lane (swap-capable). No signer implementation is bundled
# in this release: point these settings at an independently reviewed external
# MCP server. Never place its credentials in this file.
#DRY_RUN=false
#EXECUTION_MODE=coinbase-mcp
#MCP_COMMAND=/absolute/path/to/reviewed-wallet-mcp-server
#MCP_ALLOWED_TOOLS=get_wallet_details,get_balance,get_token_address,get_swap_price,swap
#MCP_SWAP_TOOL=swap
# Example AgentKit-shaped tools — money-movers MUST appear in GUARDED_TOOLS too,
# or the loop refuses them:
#MCP_ALLOWED_TOOLS=WalletActionProvider_get_wallet_details,ERC20ActionProvider_get_balance,ERC20ActionProvider_get_erc20_token_address,ERC20ActionProvider_transfer,ERC20ActionProvider_approve,ERC20ActionProvider_get_allowance,CdpEvmWalletActionProvider_get_swap_price,CdpEvmWalletActionProvider_swap,CdpEvmWalletActionProvider_list_spend_permissions,CdpEvmWalletActionProvider_use_spend_permission,WalletActionProvider_native_transfer
#GUARDED_TOOLS=swap_execute,mcp_CdpEvmWalletActionProvider_swap,mcp_CdpEvmWalletActionProvider_use_spend_permission,mcp_ERC20ActionProvider_transfer,mcp_ERC20ActionProvider_approve,mcp_WalletActionProvider_native_transfer
#
# Cobo lane (transfer/observe/pact flows; setup: see cobo-wallet-server/.env.example):
#EXECUTION_MODE=cobo-mcp
#MCP_COMMAND=bash cobo-wallet-server/run.sh
#MCP_ALLOWED_TOOLS=list_wallets,get_wallet,list_wallet_addresses,get_balance,submit_pact,get_pact,list_pacts,transfer_tokens,estimate_transfer_fee,get_transaction_record_by_request_id,list_transaction_records,get_audit_logs
#
# Shared:
#MCP_ARGS=
# MCP_ENV_FILE=path/to/server.env   (extra env injected into the external wallet
#   process only; keys still never live in THIS file)
# Max % divergence between the web price chain and the Chainlink aggregator before refusing a trade.
#ORACLE_MAX_DIVERGENCE_PCT=2

# ── Kronos forecast lane (readonly signal, no keys, no signing) ──
# kronos_forecast spawns kronos-server/run.sh (own Python venv, vendored MIT
# model code — see kronos-server/ATTRIBUTION.md). Defaults below; no .env edit
# is needed once the venv is built (see kronos-server/requirements.txt).
# First call downloads model weights from HuggingFace (~100MB, one time).
#KRONOS_COMMAND=kronos-server/run.sh
#KRONOS_ARGS=
#KRONOS_TIMEOUT_MS=300000

# ── Hands exec lane (Phase 12.3) ────────────────────────────────────────────
# Deny-default: exec_run refuses EVERY command not named here (exact or prefix
# match, no shell). Empty/absent = the frog cannot run anything.
#COMMAND_ALLOWLIST=npm test,npm run check,npm run doctor
# D0: exec_run additionally requires /usr/bin/bwrap. Commands run with no network,
# a read-only host root, hidden /home, writable data/sandbox only, and the source
# mirror remounted read-only. Missing bwrap = honest refusal, never fallback exec.
# Recommended sandbox set (2026-09-04): the CONFINEMENT is bwrap (--unshare-all,
# read-only root, tmpfs /home, only the sandbox cwd writable, scrubbed env, no
# shell) — this list is friction-reduction inside those walls, not the defense.

# ── Session memory (background extractor; memory-carried compaction) ───────
# After every run a background extractor rewrites ONE markdown file per chat
# (data/memory/session/<chatId>.md) from the recent conversation — fail-open,
# advisory-only, never authority, touches nothing else. Structure (9 template
# sections, headers + italic instruction lines) is validated in code; a bad
# reply is refused whole and the previous file stands.
# ON by default; SESSION_MEMORY=off kills the extractor.
#SESSION_MEMORY=on
# Gates (read at fire time, no recompile): a fresh chat must exceed INIT_CHARS
# once; after a flush, the TRANSCRIPT FILE must grow GROWTH_CHARS (monotonic,
# restart-safe) AND either MIN_TOOL_CALLS assistant tool calls have happened
# since the flush or the thread ends on a natural break.
#SESSION_MEMORY_INIT_CHARS=20000
#SESSION_MEMORY_GROWTH_CHARS=8000
#SESSION_MEMORY_MIN_TOOL_CALLS=3
#SESSION_MEMORY_DIGEST_BUDGET=32000
#SESSION_MEMORY_MAX_TOTAL_CHARS=16000
# Memory-carried compaction (the lossless-ish arc): when the thread hits the
# autocompact trigger, the memory file replaces the one-shot LLM summary and
# only a raw suffix is kept; the transcript always holds the full text.
# OFF by default — legacy autocompact runs until you arm it. SESSION_MEMORY
# itself can stay off/on independently.
#SESSION_MEMORY_COMPACT=on
#SESSION_MEMORY_COMPACT_KEEP=
